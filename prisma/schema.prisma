generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MODERATOR
  MEMBER
}

enum KnowledgeCategory {
  BACKEND
  FRONTEND
  DATABASE
  DEVOPS
  TESTING
  GENERAL
}

model User {
  id                     String          @id @default(cuid())
  name                   String
  email                  String          @unique
  passwordHash           String
  role                   Role            @default(MEMBER)
  bio                    String?
  avatarUrl              String?
  snippets               CodeSnippet[]
  documents              Documentation[]
  threads                ForumThread[]
  comments               ForumComment[]
  chatMessages           ChatMessage[]
  bookmarks              Bookmark[]
  sharedDocuments        DocumentShare[]
  auditLogs              AuditLog[]
  sentFriendRequests     Friendship[]    @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]    @relation("FriendshipAddressee")
  sentMessages           DirectMessage[] @relation("SentMessages")
  receivedMessages       DirectMessage[] @relation("ReceivedMessages")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model CodeSnippet {
  id          String            @id @default(cuid())
  ticketNo    String
  title       String
  description String?           @db.Text
  reason      String            @db.Text
  impact      String?           @db.Text
  language    String
  framework   String?
  category    KnowledgeCategory @default(GENERAL)
  beforeCode  String            @db.Text
  afterCode   String            @db.Text
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    SnippetVersion[]

  @@index([ticketNo])
  @@index([language])
  @@index([category])
  @@index([authorId])
}

model Documentation {
  id          String             @id @default(cuid())
  title       String
  excerpt     String?
  content     String             @db.Text
  language    String
  category    KnowledgeCategory  @default(GENERAL)
  tags        String[]           @default([])
  isPublished Boolean            @default(true)
  visibility  DocumentVisibility @default(PUBLIC)
  authorId    String
  sharedWith  DocumentShare[]
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([language])
  @@index([category])
  @@index([authorId])
}

model DocumentShare {
  id         String        @id @default(cuid())
  documentId String
  userId     String
  document   Documentation @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

enum DocumentVisibility {
  PUBLIC
  PRIVATE
}

model ForumThread {
  id        String            @id @default(cuid())
  title     String
  content   String            @db.Text
  category  KnowledgeCategory @default(GENERAL)
  tags      String[]          @default([])
  authorId  String
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  ForumComment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([category])
  @@index([authorId])
}

model ForumComment {
  id         String      @id @default(cuid())
  content    String      @db.Text
  isAccepted Boolean     @default(false)
  threadId   String
  thread     ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([threadId])
  @@index([authorId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Bookmark {
  id        String       @id @default(cuid())
  userId    String
  targetId  String
  type      BookmarkType
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum BookmarkType {
  SNIPPET
  DOCUMENTATION
  FORUM
}

model SnippetVersion {
  id         String      @id @default(cuid())
  snippetId  String
  version    Int
  beforeCode String      @db.Text
  afterCode  String      @db.Text
  reason     String      @db.Text
  createdAt  DateTime    @default(now())
  snippet    CodeSnippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String  @id @default(cuid())
  userId      String
  action      String
  entity      String
  entityId    String?
  description String  @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, isRead])
}
